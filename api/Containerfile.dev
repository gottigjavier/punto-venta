# api/Containerfile.dev
# Development image for the Fastify API.
# Multi-stage (same healthy pattern as the prod `api/Containerfile`):
#   builder  → npm ci + prisma generate + tsc build (produces ./dist)
#   runtime  → lean final image with the built dist + prod deps + tsx (dev runner)
#
# Two ways to run this image:
#   * Watch mode: podman-pod/pod.yaml mounts ./src (./src:/app/src:ro) and runs
#     `tsx watch src/main.ts` → source edits hot-reload WITHOUT an image rebuild.
#   * Standalone / podman-compose.yml: they do NOT override the command, so the
#     CMD below runs and the API serves the COMPILED dist (the ./src mount is
#     inert there — it is only there for parity with the watch-mode flow).
# NOT for production — use api/Containerfile for that.

# ─── Stage 1: Builder ─────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install ALL dependencies (dev + prod) so tsc can compile.
COPY package*.json ./
RUN for i in 1 2 3; do npm ci --fetch-retries=3 --fetch-retry-mintimeout=10000 --fetch-retry-maxtimeout=60000 && break || sleep 10; done && npm cache clean --force

# Prisma client (needs the schema + engines before building TS).
COPY prisma ./prisma/
RUN npx prisma generate

# Build TypeScript → ./dist
COPY tsconfig.json ./
COPY src ./src/
RUN npm run build

# Trim to production deps only → smaller node_modules in the runtime stage.
# This DOES drop tsx (it is a devDependency); the runtime stage reinstalls it
# on purpose, for the watch-mode entrypoint.
RUN npm prune --omit=dev

# ─── Stage 2: Runtime (dev) ───────────────────
FROM node:22-alpine

# Non-root user (mirrors prod security posture)
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Only the compiled output + prod deps (no source, no dev deps → small image)
COPY --from=builder --chown=appuser:appgroup /app/dist ./dist
COPY --from=builder --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /app/package.json ./
COPY --from=builder --chown=appuser:appgroup /app/prisma ./prisma

# Dev runner, installed on purpose (the builder pruned devDependencies).
# GLOBAL on purpose: `npm install --no-save tsx` reconciles the dependency tree
# against package.json and would drag every other devDependency (eslint, vitest,
# playwright…) back into this stage. Running as root here keeps the global
# prefix writable; appuser can execute the binary.
RUN npm install -g tsx@4

USER appuser

EXPOSE 3001

# ─── Runtime ──────────────────────────────────
# Standalone fallback: serves the COMPILED dist.
# For watch mode over the live-mounted ./src, override the command with:
#   command: ["tsx", "watch", "src/main.ts"]
# (that is exactly what podman-pod/pod.yaml does).
CMD ["node", "dist/main.js"]
