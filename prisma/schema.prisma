generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_usuario    String           @db.VarChar(100)
  nik_usuario       String           @unique @db.VarChar(50)
  password_hash     String           @db.VarChar(255)
  email             String           @unique @db.VarChar(255)
  telefono          String?          @db.VarChar(20)
  rol               Rol
  activo            Boolean          @default(true)
  intentos_fallidos Int              @default(0)
  bloqueado_hasta   DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?        @db.Timestamptz(6)
  cierres_apertura  CierreCaja[]     @relation("CierreCaja_apertura")
  cierres_cierre    CierreCaja[]     @relation("CierreCaja_cierre")
  movimientos_caja  MovimientoCaja[]
  ventas            Venta[]

  @@index([nik_usuario])
  @@index([email])
  @@index([rol])
}

model Producto {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                    String         @db.VarChar(200)
  codigo                    String         @db.VarChar(50)
  precio_venta              Decimal        @default(0) @db.Decimal(10, 2)
  rubro_id                  String         @db.Uuid
  proveedor_id              String         @db.Uuid
  unidad_medida             UnidadMedida   @default(unidad)
  created_at                DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?      @db.Timestamptz(6)
  cantidad_aviso            Decimal        @default(0) @db.Decimal(10, 3)
  activo                    Boolean        @default(true)
  vencimiento_preaviso_dias Int?           @default(30)
  detalles_venta            DetalleVenta[]
  lotes                     Lote[]
  proveedor                 Proveedor      @relation(fields: [proveedor_id], references: [id])
  rubro                     Rubro          @relation(fields: [rubro_id], references: [id])

  @@unique([codigo, proveedor_id])
  @@index([nombre])
  @@index([codigo])
  @@index([rubro_id])
  @@index([proveedor_id])
}

model Lote {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id         String         @db.Uuid
  numero_lote         String?        @db.VarChar(50)
  cantidad_disponible Decimal        @default(0) @db.Decimal(10, 3)
  fecha_compra        DateTime?      @db.Date
  fecha_vencimiento   DateTime?      @db.Date
  precio_compra       Decimal        @default(0) @db.Decimal(10, 2)
  estado              EstadoLote     @default(activo)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  detalles_venta      DetalleVenta[]
  producto            Producto       @relation(fields: [producto_id], references: [id])

  @@index([producto_id, estado])
  @@index([producto_id, fecha_vencimiento])
  @@index([estado])
}

model Proveedor {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razon_social     String     @db.VarChar(200)
  representante    String?    @db.VarChar(150)
  cuit             String?    @unique @db.VarChar(13)
  direccion_postal String?
  email            String?    @db.VarChar(255)
  telefonos        Json?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?  @db.Timestamptz(6)
  productos        Producto[]

  @@index([razon_social])
  @@index([cuit])
}

model Rubro {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String     @unique @db.VarChar(100)
  descripcion String?
  activo      Boolean    @default(true)
  productos   Producto[]

  @@index([nombre])
}

model Venta {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String         @db.Uuid
  total          Decimal        @db.Decimal(12, 2)
  estado         EstadoVenta    @default(pendiente)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  cierre_caja_id String?        @db.Uuid
  detalles_venta DetalleVenta[]
  cierre_caja    CierreCaja?    @relation(fields: [cierre_caja_id], references: [id])
  usuario        Usuario        @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([created_at])
  @@index([estado])
  @@index([cierre_caja_id])
}

model DetalleVenta {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venta_id        String   @db.Uuid
  producto_id     String   @db.Uuid
  cantidad        Decimal  @db.Decimal(10, 3)
  precio_unitario Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  lote_id         String?  @db.Uuid
  lote            Lote?    @relation(fields: [lote_id], references: [id], onDelete: Restrict)
  producto        Producto @relation(fields: [producto_id], references: [id])
  venta           Venta    @relation(fields: [venta_id], references: [id])

  @@index([venta_id])
  @@index([producto_id])
  @@index([lote_id])
}

model CierreCaja {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_apertura      DateTime            @default(now()) @db.Timestamptz(6)
  fecha_cierre        DateTime?           @db.Timestamptz(6)
  usuario_apertura_id String              @db.Uuid
  usuario_cierre_id   String?             @db.Uuid
  monto_total         Decimal             @default(0) @db.Decimal(12, 2)
  cantidad_ventas     Int                 @default(0)
  estado              EstadoCierre        @default(abierto)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  egresos_total       Decimal             @default(0) @db.Decimal(12, 2)
  ingresos_total      Decimal             @default(0) @db.Decimal(12, 2)
  usuario_apertura    Usuario             @relation("CierreCaja_apertura", fields: [usuario_apertura_id], references: [id])
  usuario_cierre      Usuario?            @relation("CierreCaja_cierre", fields: [usuario_cierre_id], references: [id])
  detalles            CierreCajaDetalle[]
  movimientos         MovimientoCaja[]
  ventas              Venta[]

  @@index([estado])
  @@index([fecha_cierre])
}

model MovimientoCaja {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           TipoMovimiento
  monto          Decimal        @db.Decimal(10, 2)
  descripcion    String?
  usuario_id     String         @db.Uuid
  cierre_caja_id String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  cierre_caja    CierreCaja?    @relation(fields: [cierre_caja_id], references: [id])
  usuario        Usuario        @relation(fields: [usuario_id], references: [id])

  @@index([cierre_caja_id])
  @@index([created_at])
  @@index([usuario_id])
}

model CierreCajaDetalle {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cierre_caja_id String     @db.Uuid
  tipo           String
  referencia_id  String     @db.Uuid
  nombre         String     @db.VarChar(200)
  cantidad       Decimal    @default(0) @db.Decimal(12, 3)
  monto_total    Decimal    @default(0) @db.Decimal(12, 2)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  cierre_caja    CierreCaja @relation(fields: [cierre_caja_id], references: [id])

  @@index([cierre_caja_id])
  @@index([tipo])
}

enum Rol {
  admin
  gerente
  despachador
}

enum UnidadMedida {
  unidad
  kg
  g
  l
  ml
}

enum EstadoVenta {
  pendiente
  completada
  cancelada
}

enum EstadoCierre {
  abierto
  cerrado
}

enum TipoMovimiento {
  ingreso
  egreso
}

enum EstadoLote {
  activo
  agotado
  vencido
  descartado
}
